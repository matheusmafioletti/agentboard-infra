# Host nginx — AgentBoard (edge TLS terminator)
# Copy to /etc/nginx/sites-available/agentboard on the VPS, then:
#   sudo ln -sf /etc/nginx/sites-available/agentboard /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Prerequisites:
#   - Docker stack binds nginx to 127.0.0.1:8080 (docker-compose.prod.yml)
#   - DNS A record: agentboard.matheusmafioletti.com → VPS public IP
#
# After first HTTP-only deploy, run certbot:
#   sudo certbot --nginx -d agentboard.matheusmafioletti.com

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream agentboard_docker {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name agentboard.matheusmafioletti.com;

    client_max_body_size 10m;

    location / {
        proxy_pass http://agentboard_docker;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
