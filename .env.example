# --- Local development (docker-compose.yml) ---
POSTGRES_USER=agentboard
POSTGRES_PASSWORD=agentboard
POSTGRES_DB=agentboard
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Production demo (docker-compose.prod.yml) — copy to .env.prod on VPS ---
# GHCR_REGISTRY=ghcr.io/agentboard
# AUTH_IMAGE_TAG=latest
# BOARD_IMAGE_TAG=latest
# API_DOCS_IMAGE_TAG=latest
# WEB_IMAGE_TAG=latest
# HTTP_PORT=80
#
# DEMO_PUBLIC_URL=https://demo.example.com
# CORS_ALLOWED_ORIGINS=https://demo.example.com
# WEBSOCKET_ALLOWED_ORIGINS=https://demo.example.com
# INVITE_BASE_URL=https://demo.example.com
# JWT_SECRET=replace-with-at-least-32-random-characters
